<!-- /snippets/video-popup.liquid -->

{% comment %}

  Required params:
  video - video object or a string containing a youtube or vimeo link
          Youtube link can be youtube.com or youtu.be
          If the link is youtube.com/watchv=[ID] then v=[ID] must be the first param

  Example:
  {% render 'video-popup', video: section.settings.video, unique: section.id, text: section.settings.popup_text %}

{% endcomment %}

{%- assign video_type = video.type -%}
{%- assign video_id = video.id -%}
{%- assign video_url = video | append: '' -%}
{%- assign video_hash = '' -%}
{%- assign is_shopify_video = false -%}

{%- if video.sources != blank or video.media_type == 'video' -%}
  {%- assign video_type = 'shopify' -%}
  {%- assign is_shopify_video = true -%}
{%- endif -%}

{% comment %}
  Parse external video URLs manually so unlisted Vimeo links keep their privacy hash.
{% endcomment %}
{%- unless is_shopify_video -%}
  {% comment %}
    Infer video_type from url text
  {% endcomment %}
  {%- if video_url contains "vimeo.com" -%}
    {%- assign video_type = "vimeo" -%}
  {%- elsif video_url contains "youtube.com" -%}
    {%- assign video_type = "youtube" -%}
  {%- elsif video_url contains "youtu.be" -%}
    {%- assign video_type = "youtube" -%}
    {%- assign youtubeShortlink = true -%}
  {%- endif -%}
  {% comment %}
    Extract video ID from link url
  {% endcomment %}
  {%- assign link_array = video_url | split: '/' -%}
  {%- assign id_with_params = link_array | last -%}
  {%- if video_type == "vimeo" -%}
    {% comment %}
      https://vimeo.com/[ID]?foo=bar&baz=boo
      https://vimeo.com/[ID]/[HASH]
    {% endcomment %}
    {%- assign vimeo_parts = video_url | split: 'vimeo.com/' -%}
    {%- assign vimeo_path = vimeo_parts | last | split: '?' | first -%}
    {%- assign vimeo_segments = vimeo_path | split: '/' -%}
    {%- assign video_id = vimeo_segments | first -%}
    {%- assign query_hash = video_url | split: '?h=' | last -%}
    {%- if video_url contains '?h=' -%}
      {%- assign video_hash = query_hash | split: '&' | first -%}
    {%- elsif vimeo_segments.size > 1 -%}
      {%- assign video_hash = vimeo_segments[1] -%}
    {%- endif -%}
  {%- elsif youtubeShortlink -%}
    {% comment %}
      https://youtu.be/[ID]?foo=bar&baz=boo
    {% endcomment %}
    {%- assign starts_with_id = id_with_params | split: '?' -%}
    {%- assign video_id = starts_with_id | first -%}
  {%- elsif video_type == "youtube"  -%}
    {% comment %}
      https://youtube.com/watch?v=[ID]?foo=bar&baz=boo
    {% endcomment %}
    {%- assign first_param = id_with_params | split: '&' | first -%}
    {%- assign watch_then_id = first_param | split: '?' -%}
    {%- assign equals_id = watch_then_id[1] -%}
    {%- assign ends_with_id = equals_id | split: '=' -%}
    {%- assign video_id = ends_with_id | last -%}
  {%- endif -%}
{%- endunless -%}

{%- if is_shopify_video and video_id == blank -%}
  {%- assign video_id = unique | append: '-shopify-video' -%}
{%- endif -%}

{%- assign player_key = video_id | append: '-' | append: unique -%}
{%- if video_hash != blank -%}
  {%- assign player_key = video_id | append: '-' | append: video_hash | append: '-' | append: unique -%}
{%- endif -%}

{%- assign button_class = "play__button" -%}
{%- assign button_label = 'general.accessibility.play' | t -%}
{% if text and text != '' %}
  {%- assign button_class = "play__button--text" -%}
  {%- assign button_label = text -%}
{% endif %}

<button class="btn--play {{ button_class }}"
  data-video-popup
  data-trigger-{{ video_id }}-{{ unique }}="{{ video_id }}-{{ unique }}"
  data-unique="{{ unique }}"
  data-video-type="{{ video_type }}"
  data-video-id="{{ video_id }}"
  {% if video_hash != blank %}
    data-video-hash="{{ video_hash }}"
  {% endif %}
  {% unless is_shopify_video %}
    data-video-url="{{ video_url }}"
  {% endunless %}
  {% if pause != 'null' %}
    data-pause="{{ pause }}"
  {% endif %}
  aria-label="{{ button_label }}">
  {% render 'icon-fill-play' %}
  {% if text and text != '' %}
    <p>{{ text }}</p>
  {%- else -%}
    <span class="visually-hidden">{{ 'general.accessibility.play' | t }}</span>
  {%- endif -%}
</button>
<div class="modal micromodal-slide" id="{{ video_id }}-{{ unique }}" data-modal aria-hidden="true">
  <div class="modal__overlay" tabindex="-1" data-micromodal-close>
    <button data-micromodal-close class="modal__close" aria-label="{{ 'general.accessibility.close' | t }}"></button>
    <div class="modal__container modal__container--video"
      data-modal-content
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'general.accessibility.play' | t }}">
      <div class="rte__video-wrapper">
        {%- if is_shopify_video -%}
          {{ video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '1200x', class: 'modal__video', data-modal-video: '' }}
        {%- else -%}
          <div data-player="{{ player_key }}">
            <div data-video-id="{{ video_id }}"></div>
            {% if video_hash != blank %}
              <div data-video-hash="{{ video_hash }}"></div>
            {% endif %}
            <div data-video-url="{{ video_url }}"></div>
            <div data-replace></div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
