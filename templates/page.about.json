{"sections":{"section_image_gqKP6c":{"type":"section-image","settings":{"image":"shopify:\/\/shop_images\/Brand-Story-Desktop-09.png","mobile_image":"shopify:\/\/shop_images\/Brand-Story-09_f0842e59-0d83-47ee-9c87-741086ff3de2.png","max_width":100,"x_align":"center","color_bg":"palette--light bg--neutral","width":"wrapper","padding_top":36,"padding_bottom":0}},"main":{"type":"page","disabled":true,"settings":{"kicker":"","kicker_size":3,"show_title":false,"title_size":8,"show_content":true,"content_size":5,"align_text":"text-center","text_color":"text--neutral","bg":"palette--light bg--neutral","width":"wrapper--narrow","padding_top":52,"padding_bottom":12}},"section_richtext_RTbeaY":{"type":"section-richtext","blocks":{"text_QMyCDG":{"type":"text","settings":{"text":"<p>Green Envee was built upon a mission to create clean, sustainable products that could better the mind + body from a holistic approach. Our co-founder was in search of a non-toxic skincare solution to heal his daughter’s eczema and found a gap in the industry for products free of fragrance, filler, irritants and toxic ingredients. With a drive to close this gap and help a family member, Green Envee was born in 2009 with the creation of Zen Body Lotion. Today, Green Envee surpasses the highest standards for clean beauty in spa products on a global level. High performance, results driven, vegan and cruelty free, Green Envee truly is the culmination of years of research and dedication to creating transformative skincare products free from toxins. Our products are formulated with sustainably sourced plant actives by our team of world renowned cosmetic chemists and herbalists in our state of the art lab located in the Chicagoland area.<\/p>","text_size":4,"text_columns":1}}},"block_order":["text_QMyCDG"],"settings":{"align_text":"text-center","text_color":"text--neutral","bg":"palette--light bg--neutral","content_width":2000,"width":"wrapper","padding_top":32,"padding_bottom":86}},"section_double_EP6knr":